{
  "manifest_version": 3,
  "name": "EvidencIA — Fact-Checking para YouTube",
  "version": "1.0.0",
  "description": "Extensão de checagem de fatos e veracidade de afirmações em vídeos do YouTube com IA e painel lateral.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/panel/index.html", "assets/*"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "action": {
    "default_title": "EvidencIA - Fact-Checking"
  }
}
