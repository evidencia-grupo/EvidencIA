{
  "name": "evidencia-extension",
  "version": "1.0.0",
  "description": "Extensao Manifest V3 de checagem factual para o YouTube",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc && vite build --mode development",
    "build:prod": "tsc && vite build --mode production",
    "package": "npm run build:prod && npm run verify:store && cd dist && zip -qr ../evidencia-chrome-web-store.zip . && cd .. && echo evidencia-chrome-web-store.zip gerado",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "verify:store": "node scripts/verify-store-package.mjs",
    "store:screenshots": "npm run build && node scripts/store-screenshots.mjs"
  },
  "dependencies": {
    "preact": "^10.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/chrome": "^0.0.268",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "^4.13.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.4.5",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
