PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Provedores de IA / LLMs (ADR-002: Chaves restritas ao servidor)
# Apenas mock está implementado. Outros valores retornam HTTP 503.
# Mock é identificado como demonstração na resposta e no painel.
LLM_PROVIDER=mock
LLM_API_KEY=sua_chave_de_ia_aqui
LLM_TIMEOUT_SECONDS=8.0

# Motores de Busca e Fact-Checking
SEARCH_API_KEY=sua_chave_de_busca_aqui

# Governança e Proteção contra Abuso (RNF-04)
RATE_LIMIT_MAX_PER_MINUTE=60
CORS_ALLOWED_ORIGINS=https://www.youtube.com,chrome-extension://*
