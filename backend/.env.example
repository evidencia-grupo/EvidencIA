PORT=8000
ENV=development
ENVIRONMENT=development
LOG_LEVEL=info

# ==============================================================================
# OPÇÃO 1: TESTES LOCAIS IMEDIATOS (MOCK DETERMINÍSTICO)
# ==============================================================================
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=15.0

# ==============================================================================
# OPÇÃO 2: OLLAMA LOCAL (100% OFFLINE, SOBERANO E GRATUITO NO SEU COMPUTADOR)
# Requer: ollama run qwen2.5:3b
# ==============================================================================
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_TIMEOUT_SECONDS=15.0

# ==============================================================================
# OPÇÃO 3: OPENROUTER (GRATUITO NA NUVEM / RENDER / CLOUD RUN)
# Crie sua chave gratuita em https://openrouter.ai/keys
# Modelos 100% gratuitos disponíveis:
# - qwen/qwen-2.5-7b-instruct:free
# - google/gemini-2.0-flash-lite-preview:free
# - meta-llama/llama-3.3-70b-instruct:free
# ==============================================================================
# LLM_PROVIDER=remote
# REMOTE_LLM_BASE_URL=https://openrouter.ai/api/v1
# REMOTE_LLM_MODEL=qwen/qwen-2.5-7b-instruct:free
# REMOTE_LLM_API_KEY=sk-or-v1-sua-chave-aqui
# REMOTE_LLM_TIMEOUT_SECONDS=15.0

# ==============================================================================
# OPÇÃO 4: GROQ CLOUD (GRATUITO, ABERTO E ULTRARRÁPIDO NA NUVEM)
# Crie sua chave gratuita em https://console.groq.com/keys
# ==============================================================================
# LLM_PROVIDER=remote
# REMOTE_LLM_BASE_URL=https://api.groq.com/openai/v1
# REMOTE_LLM_MODEL=llama-3.3-70b-versatile
# REMOTE_LLM_API_KEY=gsk_sua-chave-aqui
# REMOTE_LLM_TIMEOUT_SECONDS=15.0

# ==============================================================================
# GOVERNANÇA, RATE LIMIT E CORS
# ==============================================================================
RATE_LIMIT_MAX_PER_MINUTE=60
CORS_ALLOWED_ORIGINS=*

# Google Fact Check Tools API (Opcional para checagens em tempo real)
# GOOGLE_FACT_CHECK_API_KEY=sua_chave_google_fact_check_aqui
