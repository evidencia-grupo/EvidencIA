PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Provedores de IA / LLMs (ADR-002: Chaves restritas ao servidor)
LLM_PROVIDER=ollama # Opções: ollama, mock, gemini, openai
LLM_API_KEY=sua_chave_de_ia_aqui
LLM_TIMEOUT_SECONDS=8.0

# Motor Local Ollama (Qwen 2.5-3B)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=6.0

# Motores de Busca e Fact-Checking (Google Fact Check Tools API / ClaimReview)
SEARCH_API_KEY=sua_chave_de_busca_aqui
GOOGLE_FACT_CHECK_API_KEY=sua_chave_google_fact_check_aqui

# Governança e Proteção contra Abuso (RNF-04)
RATE_LIMIT_MAX_PER_MINUTE=60
CORS_ALLOWED_ORIGINS=https://www.youtube.com,chrome-extension://*
