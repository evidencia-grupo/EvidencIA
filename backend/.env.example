PORT=8000
ENV=development
ENVIRONMENT=development
LOG_LEVEL=info

# Demonstração local determinística; não é validação de LLM real.
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=15.0

# Alternativa local: instalar Ollama e disponibilizar o modelo escolhido.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=15.0

# Alternativa remota: configurar endpoint, modelo e chave do próprio provedor.
# LLM_PROVIDER=remote
# REMOTE_LLM_BASE_URL=https://endpoint-do-provedor.example/v1
# REMOTE_LLM_MODEL=modelo-provisionado
# REMOTE_LLM_API_KEY=
# REMOTE_LLM_TIMEOUT_SECONDS=15.0

RATE_LIMIT_MAX_PER_MINUTE=60
RATE_LIMIT_STORAGE_URI=memory://
MAX_REQUEST_BODY_BYTES=524288
CORS_ALLOWED_ORIGINS=https://www.youtube.com,chrome-extension://*
REQUIRE_AUTH=false
AUTH_SECRET=dev_evidencia_secret_key_change_in_production
# GOOGLE_FACT_CHECK_API_KEY=

# Produção exige autenticação, segredo próprio >=32 caracteres, armazenamento
# compartilhado de rate limit e origens CORS exatas (incluindo o ID da extensão).
