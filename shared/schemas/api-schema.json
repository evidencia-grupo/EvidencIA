{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidencIA Evidence-First API Contract",
  "definitions": {
    "EvidenceRelation": {
      "type": "string",
      "enum": ["supports", "contradicts", "contextualizes"]
    },
    "UncertaintyState": {
      "type": "string",
      "enum": [
        "supported",
        "contradicted",
        "contextualized",
        "conflicting",
        "insufficient_evidence"
      ]
    },
    "EvidenceProvenance": {
      "type": "object",
      "required": ["dataset", "indexedAt"],
      "properties": {
        "dataset": { "type": "string" },
        "indexedAt": { "type": "string", "format": "date-time" },
        "contentHash": { "type": "string" }
      },
      "additionalProperties": false
    },
    "TemporalContext": {
      "type": "object",
      "required": ["videoPublishedAt"],
      "properties": {
        "claimDate": { "type": "string" },
        "videoPublishedAt": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "required": [
        "sourceId",
        "relation",
        "title",
        "url",
        "publishedAt",
        "publisher",
        "provenance"
      ],
      "properties": {
        "sourceId": { "type": "string" },
        "relation": { "$ref": "#/definitions/EvidenceRelation" },
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "publishedAt": { "type": "string" },
        "publisher": { "type": "string" },
        "snippet": { "type": "string" },
        "provenance": { "$ref": "#/definitions/EvidenceProvenance" }
      },
      "additionalProperties": false
    },
    "Claim": {
      "type": "object",
      "required": ["id", "text", "temporalContext", "evidence", "uncertainty"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "temporalContext": { "$ref": "#/definitions/TemporalContext" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/definitions/Evidence" }
        },
        "uncertainty": { "$ref": "#/definitions/UncertaintyState" },
        "reflectionQuestions": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "AnalyzeRequest": {
      "type": "object",
      "required": ["videoId", "videoTitle", "channelName", "transcript"],
      "properties": {
        "videoId": { "type": "string", "minLength": 1 },
        "videoTitle": { "type": "string", "minLength": 1 },
        "channelName": { "type": "string", "minLength": 1 },
        "uploadDate": { "type": "string" },
        "durationSeconds": { "type": "integer", "minimum": 0 },
        "transcript": { "type": "string", "minLength": 50 },
        "language": { "type": "string", "default": "pt-BR" }
      },
      "additionalProperties": false
    },
    "AnalyzeResponse": {
      "type": "object",
      "required": [
        "videoId",
        "analysisMode",
        "videoTitle",
        "channelName",
        "publishedAt",
        "processingTimeMs",
        "claims",
        "limitations"
      ],
      "properties": {
        "videoId": { "type": "string" },
        "analysisMode": {
          "type": "string",
          "enum": ["evidence_first", "evidence_only"]
        },
        "videoTitle": { "type": "string" },
        "channelName": { "type": "string" },
        "publishedAt": { "type": "string" },
        "processingTimeMs": { "type": "integer", "minimum": 0 },
        "claims": {
          "type": "array",
          "items": { "$ref": "#/definitions/Claim" }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "HealthResponse": {
      "type": "object",
      "required": ["status", "version", "services", "timestamp"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["healthy", "degraded", "unhealthy"]
        },
        "version": { "type": "string" },
        "services": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
