{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidencIA API Contract",
  "definitions": {
    "VerificationClassification": {
      "type": "string",
      "enum": ["verdadeiro", "moderado", "falso", "inconclusivo"]
    },
    "ClaimVerificationStatus": {
      "type": "string",
      "enum": ["apoiada", "contraditada", "inconclusiva"]
    },
    "AnalyzeRequest": {
      "type": "object",
      "required": ["videoId", "videoTitle", "channelName", "transcript"],
      "properties": {
        "videoId": { "type": "string", "minLength": 1 },
        "videoTitle": { "type": "string", "minLength": 1 },
        "channelName": { "type": "string", "minLength": 1 },
        "uploadDate": { "type": "string", "format": "date-time" },
        "durationSeconds": { "type": "integer", "minimum": 0 },
        "transcript": { "type": "string", "minLength": 50 },
        "language": { "type": "string", "default": "pt-BR" }
      },
      "additionalProperties": false
    },
    "VerificationClaim": {
      "type": "object",
      "required": ["id", "text", "status", "evidenceSummary", "confidence", "sourceIds"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "status": { "$ref": "#/definitions/ClaimVerificationStatus" },
        "evidenceSummary": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "sourceIds": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "FactCheckingSource": {
      "type": "object",
      "required": ["id", "title", "url", "domain", "reliabilityScore"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "domain": { "type": "string" },
        "reliabilityScore": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "publishedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "TemporalContext": {
      "type": "object",
      "required": ["isOldContent", "message"],
      "properties": {
        "publicationYear": { "type": ["integer", "null"] },
        "isOldContent": { "type": "boolean" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "AnalyzeResponse": {
      "type": "object",
      "required": [
        "analysisMode",
        "videoId",
        "videoTitle",
        "channelName",
        "temporalContext",
        "analyzedAt",
        "score",
        "classification",
        "summary",
        "claims",
        "sources",
        "processingTimeMs"
      ],
      "properties": {
        "analysisMode": { "type": "string", "enum": ["demo", "live"] },
        "videoId": { "type": "string" },
        "videoTitle": { "type": "string" },
        "channelName": { "type": "string" },
        "uploadDate": { "type": ["string", "null"], "format": "date-time" },
        "temporalContext": { "$ref": "#/definitions/TemporalContext" },
        "analyzedAt": { "type": "string", "format": "date-time" },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "classification": { "$ref": "#/definitions/VerificationClassification" },
        "summary": { "type": "string" },
        "claims": {
          "type": "array",
          "items": { "$ref": "#/definitions/VerificationClaim" }
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/definitions/FactCheckingSource" }
        },
        "reflectionQuestions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "processingTimeMs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "HealthResponse": {
      "type": "object",
      "required": ["status", "version", "services", "timestamp"],
      "properties": {
        "status": { "type": "string", "enum": ["healthy", "degraded", "unhealthy"] },
        "version": { "type": "string" },
        "services": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
