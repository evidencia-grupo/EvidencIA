# ==============================================================================
# EvidencIA — Configurações de Ambiente (Backend Proxy Seguro)
# ==============================================================================
# ATENÇÃO: Nunca adicione valores reais ou credenciais de produção neste arquivo.
# Copie este arquivo para .env no diretório backend/ e configure os valores locais.
# ==============================================================================

# Configurações do Servidor
PORT=8000
ENV=development
ENVIRONMENT=development
APP_ENV=development
LOG_LEVEL=info

# Provedor de Inteligência Artificial / LLM
# Opções homologadas:
#   - ollama: Motor local via Ollama (Qwen 2.5-3B recomendado)
#   - remote: Gateway HTTP remoto compatível com OpenAI/vLLM
#   - mock: Simulação controlada para testes locais (PROIBIDO EM PRODUÇÃO - ARC-02)
LLM_PROVIDER=ollama
LLM_API_KEY=sua_chave_de_ia_aqui
LLM_TIMEOUT_SECONDS=15.0

# Motor Local Ollama (Qwen 2.5-3B)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=15.0

# Provedor Remoto (vLLM / OpenAI / LiteLLM)
REMOTE_LLM_BASE_URL=http://localhost:8001/v1
REMOTE_LLM_MODEL=qwen2.5:3b
REMOTE_LLM_API_KEY=sua_chave_remota_aqui
REMOTE_LLM_TIMEOUT_SECONDS=15.0

# Motores de Busca e Fact-Checking
# Google Fact Check Tools API (ClaimReview RAG)
GOOGLE_FACT_CHECK_API_KEY=sua_chave_google_fact_check_aqui
FACT_CHECK_API_URL=https://factchecktools.googleapis.com/v1alpha1/claims:search
SEARCH_API_KEY=sua_chave_de_busca_aqui

# Governança, Segurança e Limites de Taxa (RNF-04 / RNF-01)
RATE_LIMIT_MAX_PER_MINUTE=60
CORS_ALLOWED_ORIGINS=https://www.youtube.com,chrome-extension://*
